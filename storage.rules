rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regras para imagens de cursos
    match /courses/{courseId}/{imageId} {
      allow read: if true; // Leitura pública para todos
      allow write: if request.auth != null && request.auth.token.admin == true; // Apenas admin pode escrever
    }
    
    // Regras para imagens de posts do feed
    match /posts/{postId}/{imageId} {
      allow read: if true; // Leitura pública
      allow write: if request.auth != null; // Usuários autenticados podem postar
    }
    
    // Regras para PDFs e outros arquivos
    match /edital/{fileId} {
      allow read: if true; // Leitura pública
      allow write: if request.auth != null && request.auth.token.admin == true; // Apenas admin
    }
    
    // Regras para avatares de usuários
    match /avatars/{userId}/{imageId} {
      allow read: if true; // Leitura pública
      allow write: if request.auth != null && request.auth.uid == userId; // Dono do avatar
    }
  }
}
