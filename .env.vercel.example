# Exemplo de arquivo de ambiente para Vercel
# Copie para .env.local (local) ou configure no painel do Vercel
# NÃO commitar arquivos .env com chaves reais

# Única chave Gemini usada pelo app
VITE_GEMINI_API_KEY=SUA_CHAVE_AQUI
# Opcional: sobrescreve o modelo principal (padrão: gemini-3.6-flash)
# VITE_GEMINI_MODEL=gemini-3.6-flash

VITE_GROQ_API_KEY=SUA_CHAVE_GROQ_OPCIONAL
VITE_GOOGLE_SEARCH_API_KEY=OPCIONAL
VITE_GOOGLE_SEARCH_ENGINE_ID=OPCIONAL

# Mercado Pago — Public Key pode ser VITE_ (client). Access Token/Secret NUNCA com VITE_
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Opcional: URL pública do webhook (padrão: https://SEU_DOMINIO/api/mercadopago/webhook)
# MERCADOPAGO_WEBHOOK_URL=
# Opcional: service account JSON para liberar acesso no webhook Next
# FIREBASE_SERVICE_ACCOUNT_JSON=

# No Vercel: Settings → Environment Variables → adicionar as chaves → Redeploy
