# Exemplo de arquivo de ambiente para Vercel
# Copie para .env.local (local) ou configure no painel do Vercel
# NÃO commitar arquivos .env com chaves reais

# ── Secrets LLM — SOMENTE servidor (sem VITE_ / NEXT_PUBLIC_) ──
GEMINI_API_KEY=SUA_CHAVE_AQUI
# Opcional: sobrescreve o modelo principal no client (não é secret)
# VITE_GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=SUA_CHAVE_GROQ_OPCIONAL
GOOGLE_SEARCH_API_KEY=OPCIONAL
GOOGLE_SEARCH_ENGINE_ID=OPCIONAL

# Firebase client (públicos por design — restrinja no Google Cloud Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Service account JSON (servidor) — auth das rotas /api/* e webhook
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Mercado Pago — Public Key pode ser VITE_ (client). Access Token/Secret NUNCA com VITE_
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Opcional: URL pública do webhook (padrão: https://SEU_DOMINIO/api/mercadopago/webhook)
# MERCADOPAGO_WEBHOOK_URL=

# No Vercel: Settings → Environment Variables → adicionar as chaves → Redeploy
# Remova qualquer VITE_GEMINI_API_KEY / VITE_GROQ_API_KEY antigas do painel.
