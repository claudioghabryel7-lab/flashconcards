# Exemplo de arquivo de ambiente para Vercel
# Copie este arquivo para .env.vercel e preencha com suas chaves reais
# NÃO commitar o arquivo .env.vercel com as chaves reais

# Firebase Web Push (notificações no celular — Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=SUA_CHAVE_VAPID_AQUI
NEXT_PUBLIC_FIREBASE_VAPID_KEY=SUA_CHAVE_VAPID_AQUI

VITE_GEMINI_API_KEY=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_1=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_2=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_3=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_4=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_5=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_6=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_7=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_8=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_9=SUA_CHAVE_AQUI
VITE_GEMINI_API_KEY_10=SUA_CHAVE_AQUI
VITE_GROQ_API_KEY=SUA_CHAVE_GROQ_OPCIONAL
VITE_GOOGLE_SEARCH_API_KEY=OPCIONAL
VITE_GOOGLE_SEARCH_ENGINE_ID=OPCIONAL

# No Vercel: Settings → Environment Variables → adicionar as mesmas chaves → Redeploy

# Mercado Pago (checkout transparente — production)
# Public key pode ficar pública; access token só no servidor (NÃO use NEXT_PUBLIC_)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key
MERCADOPAGO_PUBLIC_KEY_PROD=APP_USR-sua-public-key
MERCADOPAGO_ACCESS_TOKEN_PROD=APP_USR-seu-access-token
MERCADOPAGO_MODE=prod
