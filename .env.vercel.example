# Exemplo de arquivo de ambiente para Vercel
# Copie este arquivo para .env.local (local) ou configure no painel do Vercel
# NÃO commitar arquivos .env com chaves reais

# Única chave Gemini usada pelo app
VITE_GEMINI_API_KEY=SUA_CHAVE_AQUI

VITE_GROQ_API_KEY=SUA_CHAVE_GROQ_OPCIONAL
VITE_GOOGLE_SEARCH_API_KEY=OPCIONAL
VITE_GOOGLE_SEARCH_ENGINE_ID=OPCIONAL

# No Vercel: Settings → Environment Variables → adicionar VITE_GEMINI_API_KEY → Redeploy
