# Exemplo de arquivo de ambiente para Vercel / local
# Copie para .env.local (local) ou configure no painel do Vercel
# NÃO commitar arquivos .env com chaves reais

# ── IA local (Ollama no SEU PC) — substitui o Gemini pago ──
# Se o Next.js roda no mesmo PC do Ollama:
OLLAMA_BASE_URL=http://localhost:11434
# Se o site está na Vercel, aponte para um túnel do seu PC, ex.:
# OLLAMA_BASE_URL=https://seu-tunel.trycloudflare.com
OLLAMA_MODEL=llama3.2
# Opcional: cadeia de fallback (vírgula)
# OLLAMA_MODELS=llama3.2,qwen2.5:14b,mistral

# Legado Gemini — NÃO é mais usado para geração de conteúdo
# GEMINI_API_KEY=

GROQ_API_KEY=SUA_CHAVE_GROQ_OPCIONAL
GOOGLE_SEARCH_API_KEY=OPCIONAL
GOOGLE_SEARCH_ENGINE_ID=OPCIONAL

# Firebase client (públicos por design — restrinja no Google Cloud Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Auth das rotas /api/*:
# - Basta VITE_FIREBASE_API_KEY (já usada no client) — fallback Identity Toolkit
# - Opcional: FIREBASE_SERVICE_ACCOUNT_JSON para Admin SDK + webhook Firestore
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Mercado Pago — Public Key pode ser VITE_ (client). Access Token/Secret NUNCA com VITE_
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Opcional: URL pública do webhook (padrão: https://SEU_DOMINIO/api/mercadopago/webhook)
# MERCADOPAGO_WEBHOOK_URL=

# No Vercel: Settings → Environment Variables → OLLAMA_BASE_URL + OLLAMA_MODEL → Redeploy
# Remova GEMINI_API_KEY / VITE_GEMINI_API_KEY do painel se não for mais usar.
