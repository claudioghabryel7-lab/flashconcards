rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /** Conteúdo liberado pelo admin (status ausente = bloqueado para alunos) */
    function isPublishedContent() {
      return resource != null && resource.data.get('status', 'indisponivel') == 'disponivel';
    }

    function canReadPublishedContent() {
      return isAuthenticated() && (isAdmin() || isPublishedContent());
    }

    /** Permite get em documento inexistente (ex.: antes da primeira geração) */
    function canGetPublishedContent() {
      return isAuthenticated() && (
        resource == null ||
        isAdmin() ||
        isPublishedContent()
      );
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() || (request.auth != null && request.auth.uid == userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        (isOwner(userId) && 
        (request.resource.data.role == resource.data.role ||
          !resource.data.hasAny(['role']) ||
          (request.resource.data.role == 'admin' && 
           resource.data.role != 'admin'))) ||
        isAdmin()
      );
      allow delete: if isAdmin();
      
      match /desempenhoIncidencia/{docId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId;
        allow update: if request.auth.uid == userId;
        allow delete: if request.auth.uid == userId;
      }
      
      match /desempenhoTopico/{docId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId;
        allow update: if request.auth.uid == userId;
        allow delete: if request.auth.uid == userId;
      }

      /** Trilha de estudo — progresso individual do aluno */
      match /trilha/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /trilhaSessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /trilhaManualEntries/{entryId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /profilePosts/{postId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      match /generationJobs/{jobId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      /** Notificações do aluno (ex.: sinalização corrigida) */
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAdmin();
      }

      match /studySessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
    
    match /flashcards/{cardId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow update: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/flashcards/$(cardId)) &&
                   get(/databases/$(database)/documents/flashcards/$(cardId)).data.userId == request.auth.uid;
      allow delete: if isAdmin();
      allow delete: if isAuthenticated() && 
                    exists(/databases/$(database)/documents/flashcards/$(cardId)) &&
                    get(/databases/$(database)/documents/flashcards/$(cardId)).data.userId == request.auth.uid;
    }
    
    match /progress/{progressId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /userProgress/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /chats/{userId}/messages/{messageId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Interruptor público dos comentários mocados (home)
    match /config/mockReviews {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /professorSupervisorReviews/{reviewId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /professorSupervisorHistory/{historyId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /professorSupervisorQueue/{itemId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    
    match /config/popupBanner {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && 
                                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /homeBanners/{bannerId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Collection group queries em contentComments (ex.: comentários do perfil)
    match /{path=**}/contentComments/{commentId} {
      allow read: if isAuthenticated();
    }
    
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      match /subjects/{subjectId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && 
                                        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        
        match /flashcards/{flashcardId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
          allow update: if isAuthenticated();
          allow delete: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }
      }
      
      match /prompts/{promptId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /config/{configId} {
        allow read: if isAuthenticated() && (
          configId != 'redacao' ||
          resource.data.status == 'disponivel' ||
          isAdmin()
        );
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /cronograma/{monthKey} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        
        // Subcoleção userSchedules para schedules personalizados de cada usuário
        match /userSchedules/{userId} {
          allow read: if isAuthenticated() && request.auth.uid == userId;
          allow create: if isAuthenticated() && request.auth.uid == userId;
          allow update: if isAuthenticated() && request.auth.uid == userId;
          allow delete: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      match /mentoradoAutomation/{dateKey} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() &&
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /materialApoio/{docId} {
        allow read: if isAuthenticated() && 
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /praticaIncidencia/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /vesperaProva/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /editalVerticalizado/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

        match /partes/{parteId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAdmin();
        }
      }
      
      match /materiasRevisadas/{docId} {
        allow get: if canGetPublishedContent();
        allow list: if canReadPublishedContent();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /conteudosCompletos/{docId} {
        allow get: if canGetPublishedContent();
        allow list: if canReadPublishedContent();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }

      match /topicoStatus/{docId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }
      
      match /questoesTopico/{docId} {
        allow get: if canGetPublishedContent();
        allow list: if canReadPublishedContent();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
      
      match /questoes/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
      
      match /flashcards/{flashcardId} {
        allow get: if canGetPublishedContent();
        allow list: if canReadPublishedContent();
        allow create: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      match /contentFeedback/{feedbackId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.kind == 'flag'
          && request.resource.data.contentType is string
          && request.resource.data.contentId is string;
        allow update, delete: if isAdmin();
      }

      match /contentComments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.contentType is string
          && request.resource.data.contentId is string
          && request.resource.data.text is string;
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'feedPostId', 'userName', 'userPhotoBase64'])
          ) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
        );
        allow delete: if isAdmin() || resource.data.userId == request.auth.uid;

        match /votes/{voterId} {
          allow read: if isAuthenticated();
          allow create, update: if isAuthenticated() && voterId == request.auth.uid;
          allow delete: if isAuthenticated() && voterId == request.auth.uid;
        }
      }
      
      match /conteudosIncidencia/{docId} {
        allow get: if canGetPublishedContent();
        allow list: if canReadPublishedContent();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
      
      match /questoesIncidencia/{docId} {
        allow get: if canGetPublishedContent();
        allow list: if canReadPublishedContent();
        allow create, update: if isAdmin() || isAuthenticated();
        allow delete: if isAdmin();
      }
      
      match /vesperaDeProva/{docId} {
        allow read: if true; // Leitura pública para links compartilhados
        allow create: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      // Notificações de liberação diária da Véspera (lida no app pelo aluno)
      match /vesperaNotifications/{notifId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }
    }
    
    // Links compartilhados de Véspera de Prova
    match /vesperaShares/{tokenId} {
      allow read: if true; // Leitura pública para acessar links compartilhados
      allow create: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Progresso do usuário em Véspera de Prova
    match /userVesperaProgress/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && userId == request.auth.uid;
      allow delete: if isAdmin();
      
      match /courses/{courseId} {
        allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
        allow create, update: if isAuthenticated() && userId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
                              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Comentários mocados (admin) — leitura pública para a home
    match /mockReviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /deletedUsers/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
    
    match /questoesStats/{docId} {
      function isOwnerDoc() {
        return isAuthenticated() && 
               (docId == request.auth.uid || 
                docId.matches('^' + request.auth.uid + '_.*'));
      }
      
      allow read: if isAuthenticated() && (isOwnerDoc() || isAdmin());
      allow create, update: if isAuthenticated() && isOwnerDoc();
      allow delete: if isAdmin();
    }
    
    match /studyPlannerRecommendations/{recommendationId} {
      function isOwnerRecommendation() {
        return isAuthenticated() && 
               (resource == null || resource.data.userId == request.auth.uid);
      }
      
      allow read: if isAuthenticated() && (isOwnerRecommendation() || isAdmin());
      allow create, update: if isAuthenticated() && 
                              request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /editalProgress/{progressId} {
      function isOwnerDoc() {
        return isAuthenticated() && 
               (progressId == request.auth.uid || 
                progressId.matches('^' + request.auth.uid + '_.*'));
      }
      
      allow read: if isAuthenticated() && (
        isOwnerDoc() || 
        isAdmin() ||
        (resource != null && resource.data != null && resource.data.userId == request.auth.uid)
      );
      
      allow create, update: if isAuthenticated() && 
                              request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }
    
    match /testTrials/{trialId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredUsers', 'accessCount', 'lastAccessedAt']));
    }
    
    match /sharedFlashcards/{tokenId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCount', 'lastAccessedAt'])) ||
                    (!isAuthenticated() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCount', 'lastAccessedAt']));
      allow delete: if isAdmin();
    }
    
    match /passwordResetTokens/{tokenId} {
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow read: if true;
      allow update, delete: if isAuthenticated() && 
                              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /questoesCache/{cacheId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.keys().hasAll(['questoes', 'materia', 'modulo']) &&
                     request.resource.data.questoes is list &&
                     request.resource.data.likes is int &&
                     request.resource.data.dislikes is int;
      allow update: if isAuthenticated() && 
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'updatedAt']) ||
                      isAdmin());
      allow delete: if isAdmin();
    }
    
    match /explanationsCache/{explanationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.keys().hasAll(['text']) &&
                     request.resource.data.text is string &&
                     request.resource.data.likes is int &&
                     request.resource.data.dislikes is int;
      allow update: if isAuthenticated() && 
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'updatedAt']) ||
                      isAdmin());
      allow delete: if isAdmin();
    }
    
    match /mindMapsCache/{cacheId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.keys().hasAll(['materia', 'modulo']) &&
                     request.resource.data.likes is int &&
                     request.resource.data.dislikes is int;
      allow update: if isAuthenticated() && 
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'updatedAt']) ||
                      isAdmin());
      allow delete: if isAdmin();
    }
    
    match /transactions/{transactionId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /purchaseReviews/{reviewId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /courseEntitlements/{entitlementId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false; // apenas Cloud Functions / Admin SDK
    }
    
    match /blog_articles/{articleId} {
      allow read: if !resource.exists || 
                   resource.data.status == 'published' || 
                   (resource.data.status == 'scheduled' && resource.data.scheduledAt != null && resource.data.scheduledAt <= request.time) ||
                   (isAuthenticated() && isAdmin()) ||
                   (isAuthenticated() && resource.data.authorId == request.auth.uid);
      
      allow create: if isAuthenticated() && 
                     request.resource.data.authorId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin()
      );
    }
    
    match /posts/{postId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && 
                     request.resource.data.authorId == request.auth.uid &&
                     (request.resource.data.isNews == null || isAdmin());
      
      allow update: if isAuthenticated() && 
                     request.resource.data.authorId == resource.data.authorId &&
                     (request.resource.data.isNews == resource.data.isNews || isAdmin());
      
      allow delete: if isAuthenticated() && 
                     (resource.data.authorId == request.auth.uid || isAdmin());
    }
    
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                     (resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if false;
    }
    
    match /sharedSimulados/{simuladoId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if (isAuthenticated() && 
                        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
                   || 
                   (isAuthenticated() &&
                    resource != null &&
                    resource.data != null &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts']) ||
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questions']) ||
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'questions'])));
      allow delete: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /sharedQuestoes/{questaoId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /sharedQuestoesAccess/{accessId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['completed', 'acertos', 'erros', 'aproveitamento', 'totalQuestoes', 'completedAt']);
      allow delete: if isAdmin();
    }
    
    match /leads/{leadId} {
      allow read: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if true;
      allow update: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /leisCache/{lawId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adminMateriaisConcurso/{materialId} {
      allow read, create, update, delete: if isAdmin();
    }
    
    // Progresso Individual do Edital Verticalizado
    match /userEditalProgress/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
      
      match /courses/{courseId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
    
    // Online Status
    match /onlineStatus/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /trilhaFeed/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /feedReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.followerId == request.auth.uid || isAdmin());
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /emailVerificationCodes/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
