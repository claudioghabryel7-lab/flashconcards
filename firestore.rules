rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      
      function isAuthenticated() {
        return request.auth != null;
      }
      
      function isOwner(userId) {
        return isAuthenticated() && request.auth.uid == userId;
      }
      
      function isAdmin() {
        return isAuthenticated() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /users/{userId} {
        // Permitir leitura para todos autenticados (para ranking) - apenas campos públicos
        // Também permitir leitura do próprio perfil mesmo se não estiver completamente autenticado
        allow read: if isAuthenticated() || (request.auth != null && request.auth.uid == userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && (
          (isOwner(userId) && 
          (request.resource.data.role == resource.data.role ||
            !resource.data.hasAny(['role']) ||
            // Permitir que o próprio usuário atualize role para 'admin' se o role atual não for 'admin'
            // Isso permite que o email do admin atualize seu próprio role
            (request.resource.data.role == 'admin' && 
             resource.data.role != 'admin'))) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
      
      match /flashcards/{cardId} {
        // Permitir leitura para todos autenticados
        allow read: if isAuthenticated();
        // Admin pode criar qualquer flashcard
        allow create: if isAdmin();
        // Usuário pode criar flashcards individuais (com userId)
        allow create: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid;
        // Admin pode atualizar qualquer flashcard
        allow update: if isAdmin();
        // Usuário pode atualizar seus próprios flashcards
        allow update: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/flashcards/$(cardId)) &&
                     get(/databases/$(database)/documents/flashcards/$(cardId)).data.userId == request.auth.uid;
        // Admin pode deletar qualquer flashcard
        allow delete: if isAdmin();
        // Usuário pode deletar seus próprios flashcards
        allow delete: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/flashcards/$(cardId)) &&
                     get(/databases/$(database)/documents/flashcards/$(cardId)).data.userId == request.auth.uid;
      }
      
      // 📋 Cache de Questões
      match /questoesCache/{cacheId} {
        // Permitir leitura para todos autenticados
        allow read: if isAuthenticated();
        // Admin pode criar e atualizar cache
        allow create, update: if isAdmin();
        // Apenas admin pode deletar cache
        allow delete: if isAdmin();
      }
      
      // 📋 Cache de Explicações
      match /explanationCache/{cacheId} {
        // Permitir leitura para todos autenticados
        allow read: if isAuthenticated();
        // Admin pode criar e atualizar cache
        allow create, update: if isAdmin();
        // Apenas admin pode deletar cache
        allow delete: if isAdmin();
      }
      
      // 📊 Progresso do Edital
      match /editalProgress/{progressId} {
        // Permitir leitura do próprio progresso
        allow read: if isAuthenticated() && 
                     progressId.startsWith(request.auth.uid + '_');
        // Permitir criação do próprio progresso
        allow create: if isAuthenticated() && 
                     progressId.startsWith(request.auth.uid + '_');
        // Permitir atualização do próprio progresso
        allow update: if isAuthenticated() && 
                     progressId.startsWith(request.auth.uid + '_');
        // Admin pode ler tudo
        allow read: if isAdmin();
        // Admin pode criar qualquer progresso
        allow create: if isAdmin();
        // Admin pode atualizar qualquer progresso
        allow update: if isAdmin();
        // Apenas admin pode deletar
        allow delete: if isAdmin();
      }
      
      // 📅 Progresso Diário
      match /dailyProgress/{progressId} {
        // Permitir leitura do próprio progresso
        allow read: if isAuthenticated() && 
                     progressId.startsWith(request.auth.uid + '_');
        // Permitir criação do próprio progresso
        allow create: if isAuthenticated() && 
                     progressId.startsWith(request.auth.uid + '_');
        // Permitir atualização do próprio progresso
        allow update: if isAuthenticated() && 
                     progressId.startsWith(request.auth.uid + '_');
        // Admin pode ler tudo
        allow read: if isAdmin();
        // Admin pode criar qualquer progresso
        allow create: if isAdmin();
        // Admin pode atualizar qualquer progresso
        allow update: if isAdmin();
        // Apenas admin pode deletar
        allow delete: if isAdmin();
      }
      
      // 📝 Simulados Compartilhados
      match /simulados/{simuladoId} {
        // Permitir leitura para todos autenticados
        allow read: if isAuthenticated();
        // Admin pode criar simulados
        allow create: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        // Admin pode atualizar tudo
        // Usuários autenticados podem atualizar apenas 'attempts' e 'questions' 
        // (para registrar tentativas de simulado compartilhado)
        // Nota: Esta regra permite que qualquer autenticado atualize, o que pode ser um risco
        // Se necessário, adicionar validação de token de acesso ou limitação por IP
        allow update: if (isAuthenticated() && 
                          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
                     || 
                     (isAuthenticated() &&
                      resource != null &&
                      resource.data != null &&
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questions']) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'questions'])));
        // Apenas admin pode deletar
        allow delete: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      // 📋 Leads de Simulados
      match /leads/{leadId} {
        // Apenas admin pode ler leads
        allow read: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        // Qualquer pessoa pode criar lead (formulário público)
        allow create: if true;
        // Apenas admin pode atualizar (marcar como contatado, adicionar notas)
        allow update: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        // Apenas admin pode deletar
        allow delete: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      // 📚 Cache de Leis - Sistema de cache de textos oficiais
      match /leisCache/{lawId} {
        // Permitir leitura para todos autenticados (para usar textos oficiais)
        allow read: if isAuthenticated();
        
        // Admin pode criar e atualizar leis no cache
        allow create, update: if isAdmin();
        
        // Apenas admin pode deletar leis do cache
        allow delete: if isAdmin();
      }
      
      // ⚙️ Configurações do Sistema
      match /config/{configId} {
        // Permitir leitura para todos autenticados (para ler link do WhatsApp)
        allow read: if isAuthenticated();
        // Apenas admin pode criar e atualizar configurações
        allow create, update: if isAdmin();
        // Apenas admin pode deletar configurações
        allow delete: if isAdmin();
      }
      
      // 📢 Histórico de Mensagens (Broadcast)
      match /broadcastHistory/{messageId} {
        // Apenas admin pode ler histórico de mensagens
        allow read: if isAdmin();
        // Apenas admin pode criar mensagens no histórico
        allow create: if isAdmin();
        // Apenas admin pode atualizar mensagens (se necessário)
        allow update: if isAdmin();
        // Apenas admin pode deletar mensagens
        allow delete: if isAdmin();
      }
      
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
