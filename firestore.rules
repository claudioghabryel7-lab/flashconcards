rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() || (request.auth != null && request.auth.uid == userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        (isOwner(userId) && 
        (request.resource.data.role == resource.data.role ||
          !resource.data.hasAny(['role']) ||
          (request.resource.data.role == 'admin' && 
           resource.data.role != 'admin'))) ||
        isAdmin()
      );
      allow delete: if isAdmin();
      
      match /desempenhoIncidencia/{docId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId;
        allow update: if request.auth.uid == userId;
        allow delete: if request.auth.uid == userId;
      }
      
      match /desempenhoTopico/{docId} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId;
        allow update: if request.auth.uid == userId;
        allow delete: if request.auth.uid == userId;
      }
    }
    
    match /flashcards/{cardId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow update: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/flashcards/$(cardId)) &&
                   get(/databases/$(database)/documents/flashcards/$(cardId)).data.userId == request.auth.uid;
      allow delete: if isAdmin();
      allow delete: if isAuthenticated() && 
                    exists(/databases/$(database)/documents/flashcards/$(cardId)) &&
                    get(/databases/$(database)/documents/flashcards/$(cardId)).data.userId == request.auth.uid;
    }
    
    match /progress/{progressId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /userProgress/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /chats/{userId}/messages/{messageId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    match /config/popupBanner {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && 
                                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /homeBanners/{bannerId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      match /subjects/{subjectId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && 
                                        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        
        match /flashcards/{flashcardId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
          allow update: if isAuthenticated();
          allow delete: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        }
      }
      
      match /prompts/{promptId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /config/{configId} {
        allow read: if isAuthenticated() && (
          configId != 'redacao' ||
          resource.data.status == 'disponivel' ||
          isAdmin()
        );
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /cronograma/{monthKey} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        
        // Subcoleção userSchedules para schedules personalizados de cada usuário
        match /userSchedules/{userId} {
          allow read: if isAuthenticated() && request.auth.uid == userId;
          allow create: if isAuthenticated() && request.auth.uid == userId;
          allow update: if isAuthenticated() && request.auth.uid == userId;
          allow delete: if isAuthenticated() && request.auth.uid == userId;
        }
      }
      
      match /materialApoio/{docId} {
        allow read: if isAuthenticated() && 
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /praticaIncidencia/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /vesperaProva/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /editalVerticalizado/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /materiasRevisadas/{docId} {
        allow read: if isAuthenticated() && 
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /conteudosCompletos/{docId} {
        allow read: if isAuthenticated() &&
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }

      match /topicoStatus/{docId} {
        allow read: if isAuthenticated() && isAdmin();
        allow create, update, delete: if isAdmin();
      }
      
      match /questoesTopico/{docId} {
        allow read: if isAuthenticated() && 
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
      
      match /questoes/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
      
      match /flashcards/{flashcardId} {
        allow read: if true && 
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
      
      match /conteudosIncidencia/{docId} {
        allow read: if isAuthenticated() &&
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
      
      match /questoesIncidencia/{docId} {
        allow read: if isAuthenticated() && 
                     (resource.data.status == 'disponivel' || isAdmin());
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
      
      match /vesperaDeProva/{docId} {
        allow read: if true; // Leitura pública para links compartilhados
        allow create: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow update: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
        allow delete: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }
    }
    
    // Links compartilhados de Véspera de Prova
    match /vesperaShares/{tokenId} {
      allow read: if true; // Leitura pública para acessar links compartilhados
      allow create: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Progresso do usuário em Véspera de Prova
    match /userVesperaProgress/{userId} {
      allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && userId == request.auth.uid;
      allow delete: if isAdmin();
      
      match /courses/{courseId} {
        allow read: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
        allow create, update: if isAuthenticated() && userId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
                              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /deletedUsers/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
    
    match /questoesStats/{docId} {
      function isOwnerDoc() {
        return isAuthenticated() && 
               (docId == request.auth.uid || 
                docId.matches('^' + request.auth.uid + '_.*'));
      }
      
      allow read: if isAuthenticated() && (isOwnerDoc() || isAdmin());
      allow create, update: if isAuthenticated() && isOwnerDoc();
      allow delete: if isAdmin();
    }
    
    match /studyPlannerRecommendations/{recommendationId} {
      function isOwnerRecommendation() {
        return isAuthenticated() && 
               (resource == null || resource.data.userId == request.auth.uid);
      }
      
      allow read: if isAuthenticated() && (isOwnerRecommendation() || isAdmin());
      allow create, update: if isAuthenticated() && 
                              request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /editalProgress/{progressId} {
      function isOwnerDoc() {
        return isAuthenticated() && 
               (progressId == request.auth.uid || 
                progressId.matches('^' + request.auth.uid + '_.*'));
      }
      
      allow read: if isAuthenticated() && (
        isOwnerDoc() || 
        isAdmin() ||
        (resource != null && resource.data != null && resource.data.userId == request.auth.uid)
      );
      
      allow create, update: if isAuthenticated() && 
                              request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /presence/{userId} {
      allow read, create, update: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
      allow delete: if false;
    }
    
    match /testTrials/{trialId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredUsers', 'accessCount', 'lastAccessedAt']));
    }
    
    match /sharedFlashcards/{tokenId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && 
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCount', 'lastAccessedAt'])) ||
                    (!isAuthenticated() &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCount', 'lastAccessedAt']));
      allow delete: if isAdmin();
    }
    
    match /passwordResetTokens/{tokenId} {
      allow create: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow read: if true;
      allow update, delete: if isAuthenticated() && 
                              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /questoesCache/{cacheId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.keys().hasAll(['questoes', 'materia', 'modulo']) &&
                     request.resource.data.questoes is list &&
                     request.resource.data.likes is int &&
                     request.resource.data.dislikes is int;
      allow update: if isAuthenticated() && 
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'updatedAt']) ||
                      isAdmin());
      allow delete: if isAdmin();
    }
    
    match /explanationsCache/{explanationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.keys().hasAll(['text']) &&
                     request.resource.data.text is string &&
                     request.resource.data.likes is int &&
                     request.resource.data.dislikes is int;
      allow update: if isAuthenticated() && 
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'updatedAt']) ||
                      isAdmin());
      allow delete: if isAdmin();
    }
    
    match /mindMapsCache/{cacheId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.keys().hasAll(['materia', 'modulo']) &&
                     request.resource.data.likes is int &&
                     request.resource.data.dislikes is int;
      allow update: if isAuthenticated() && 
                     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'updatedAt']) ||
                      isAdmin());
      allow delete: if isAdmin();
    }
    
    match /transactions/{transactionId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }
    
    match /blog_articles/{articleId} {
      allow read: if !resource.exists || 
                   resource.data.status == 'published' || 
                   (resource.data.status == 'scheduled' && resource.data.scheduledAt != null && resource.data.scheduledAt <= request.time) ||
                   (isAuthenticated() && isAdmin()) ||
                   (isAuthenticated() && resource.data.authorId == request.auth.uid);
      
      allow create: if isAuthenticated() && 
                     request.resource.data.authorId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin()
      );
    }
    
    match /posts/{postId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && 
                     request.resource.data.authorId == request.auth.uid &&
                     (request.resource.data.isNews == null || isAdmin());
      
      allow update: if isAuthenticated() && 
                     request.resource.data.authorId == resource.data.authorId &&
                     (request.resource.data.isNews == resource.data.isNews || isAdmin());
      
      allow delete: if isAuthenticated() && 
                     (resource.data.authorId == request.auth.uid || isAdmin());
    }
    
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                     request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                     (resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if false;
    }
    
    match /sharedSimulados/{simuladoId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if (isAuthenticated() && 
                        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
                   || 
                   (isAuthenticated() &&
                    resource != null &&
                    resource.data != null &&
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts']) ||
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questions']) ||
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'questions'])));
      allow delete: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /sharedQuestoes/{questaoId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /sharedQuestoesAccess/{accessId} {
      allow read: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if true;
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    match /leads/{leadId} {
      allow read: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if true;
      allow update: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow delete: if isAuthenticated() && 
                   exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /leisCache/{lawId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Progresso Individual do Edital Verticalizado
    match /userEditalProgress/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
      
      match /courses/{courseId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
    
    // Online Status
    match /onlineStatus/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
