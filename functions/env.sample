# Copie para .env nesta pasta e preencha.
# Conta Google → Segurança → Verificação em 2 etapas → Senhas de app
EMAIL_USER=flashconcards@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui

# Chaves Gemini (obrigatório para geração IA no servidor)
# Opção A: rode na raiz do projeto: npm run sync:gemini-env
# Opção B: copie manualmente de .env.local (VITE_GEMINI_* → GEMINI_*)
GEMINI_API_KEY=sua_chave_principal
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# ... até GEMINI_API_KEY_9
