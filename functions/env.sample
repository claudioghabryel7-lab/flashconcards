# Copie para functions/.env e preencha antes do deploy.
# Conta Google → Segurança → Verificação em 2 etapas → Senhas de app

# ── Email (SMTP Gmail) ──
EMAIL_USER=flashconcards@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui

# ── Gemini (obrigatório para jobs de IA) ──
# Opção A: npm run sync:gemini-env (raiz do projeto)
# Opção B: copie VITE_GEMINI_* de .env.local → GEMINI_*
GEMINI_API_KEY=sua_chave_principal
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# ... até GEMINI_API_KEY_9

# ── Mercado Pago (PIX + webhook + renovação) ──
MERCADOPAGO_MODE=prod
MERCADOPAGO_ACCESS_TOKEN_PROD=APP_USR-...
MERCADOPAGO_ACCESS_TOKEN_PIX=APP_USR-...
MERCADOPAGO_PUBLIC_KEY_PROD=APP_USR-...
MERCADOPAGO_WEBHOOK_URL=https://us-central1-plegi-d84c2.cloudfunctions.net/webhookMercadoPago

# Teste (opcional — PIX usa prod mesmo em sandbox)
MERCADOPAGO_ACCESS_TOKEN_TEST=TEST-...
MERCADOPAGO_PUBLIC_KEY_TEST=TEST-...

# ── Site canônico (emails e redirects) ──
SITE_URL=https://www.flashconcards.com.br
