# Template Vercel Production — copie para .env.vercel ou preencha no dashboard
# Valores reais: rode node scripts/export-vercel-env.mjs (lê .env + functions/.env)

# Firebase (cliente)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=plegi-d84c2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=plegi-d84c2
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin — JSON da service account (uma linha)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://www.flashconcards.com.br
VITE_USE_SUPABASE=false
NEXT_PUBLIC_USE_SUPABASE=false

# Gemini (somente uma chave)
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Email
EMAIL_USER=
EMAIL_PASSWORD=

# Mercado Pago
MERCADOPAGO_MODE=prod
MERCADOPAGO_WEBHOOK_URL=https://www.flashconcards.com.br/api/mercadopago/webhook
MERCADOPAGO_ACCESS_TOKEN_PROD=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY_PROD=
MERCADOPAGO_PUBLIC_KEY=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Crons
CRON_SECRET=
